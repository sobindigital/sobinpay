# ==============================================================================
# SobinPay Developer Portal - Environment Configuration
# ==============================================================================
# Copy this file to .env.local and configure your ABA PayWay sandbox or live keys:
#   cp .env.example .env.local
#
# NOTE: Never commit your .env.local file to version control.
# ==============================================================================

# ABA PayWay Merchant ID (Provided by ABA Bank)
ABA_MERCHANT_ID=your_merchant_id

# ABA PayWay API Key (Secret key provided by ABA Bank)
ABA_API_KEY=your_api_key_here

# ABA PayWay API Gateway URL
# Sandbox:    https://checkout-sandbox.payway.com.kh
# Production: https://checkout.payway.com.kh
ABA_API_URL=https://checkout-sandbox.payway.com.kh

# Production Site URL (used for canonical URLs, sitemaps, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://pay.sobindigital.com

