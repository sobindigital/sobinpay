{
  "name": "@sobindigital/pay",
  "version": "0.1.1",
  "description": "Unified TypeScript Payment SDK for Cambodia by Sobin Digital (ABA PayWay, Bakong KHQR)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sobinpay": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sobindigital/sobinpay.git",
    "directory": "packages/pay"
  },
  "keywords": [
    "sobinpay",
    "cambodia",
    "payment",
    "gateway",
    "khqr",
    "bakong",
    "aba",
    "payway",
    "fintech",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sobindigital/core": "^0.1.1",
    "@sobindigital/provider-khqr": "^0.1.1",
    "@sobindigital/provider-payway": "^0.1.1"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "author": "Sobin Digital",
  "license": "MIT"
}
