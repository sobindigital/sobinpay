{
  "name": "@sobindigital/core",
  "version": "0.1.0",
  "description": "Core primitives, timing-safe cryptography, and money utilities for SobinPay",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sobindigital/sobinpay.git",
    "directory": "packages/core"
  },
  "keywords": [
    "sobinpay",
    "cambodia",
    "payments",
    "crypto",
    "hmac-sha512",
    "crc16"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "author": "Sobin Digital",
  "license": "MIT"
}
